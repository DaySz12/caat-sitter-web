# Copy to .env and adjust before running `docker compose up`.
# These are safe local-dev defaults — change POSTGRES_PASSWORD and JWT_SECRET
# before running this anywhere reachable outside your own machine.

POSTGRES_DB=catsitter
POSTGRES_USER=catsitter
POSTGRES_PASSWORD=catsitter_dev_password
POSTGRES_PORT=5432

API_PORT=5254
JWT_SECRET=dev-only-please-change-this-secret-key-32chars+
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

ADMINER_PORT=8082
ASPNETCORE_ENVIRONMENT=Production

# Frontends served by Docker (web = owner/sitter app, admin = admin portal)
WEB_PORT=3001
ADMIN_PORT=3000
# API address the *browser* uses. It is baked into the frontends at build time,
# so rebuild (`docker compose up -d --build`) after changing it.
PUBLIC_API_URL=http://localhost:5254

# Create test accounts (password123) when the database is empty
SEED_DEMO_DATA=true
